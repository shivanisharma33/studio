# Where the inquiry flow's /api/contact route forwards inquiries (Formspree / Zapier / Make / your own mailer).
# REQUIRED IN PRODUCTION: without it the route returns 503 and the flow shows its error state with the
# WhatsApp fallback (it never claims an inquiry was sent). In development it just logs the inquiry.
CONTACT_WEBHOOK_URL=

# Optional: post the inquiry straight from the browser to a public form endpoint instead of /api/contact.
# Never put private API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Optional countdown — ONLY for a real Studio Kunal deadline (booking window, consultation deadline, event).
# Off unless ENABLED=true and DATE is a valid future date. Never use it to invent scarcity.
NEXT_PUBLIC_COUNTDOWN_ENABLED=false
NEXT_PUBLIC_COUNTDOWN_DATE=
NEXT_PUBLIC_COUNTDOWN_LABEL=
